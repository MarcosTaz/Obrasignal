FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    FACTORY_PORTFOLIO_AGENT_HOST=0.0.0.0 \
    FACTORY_PORTFOLIO_AGENT_PORT=8788

WORKDIR /app
COPY requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r /app/requirements.txt
COPY . /app
EXPOSE 8788
CMD ["python", "-m", "factory_cloud.portfolio_agent_service", "--host", "0.0.0.0", "--port", "8788"]
