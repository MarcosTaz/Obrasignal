[Unit]
Description=Factory Cloud Global Control Tower
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/factory-cloud
EnvironmentFile=-/etc/factory-cloud/global-control.env
ExecStart=/opt/factory-cloud/.venv/bin/python -m factory_cloud.control_tower_service --host 127.0.0.1 --port 8787 --runtime-dir /var/lib/factory-cloud
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/factory-cloud

[Install]
WantedBy=multi-user.target
