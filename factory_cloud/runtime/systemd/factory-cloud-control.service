[Unit]
Description=Factory Cloud persistent control plane
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=factory-cloud-control
Group=factory-cloud
WorkingDirectory=/opt/factory-cloud/current
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-/etc/factory-cloud/control.env
ExecStart=/usr/bin/python3 -m factory_cloud.worker Ω --state /var/lib/factory-cloud/state.sqlite3
Restart=always
RestartSec=5
UMask=0007
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/var/lib/factory-cloud

[Install]
WantedBy=factory-cloud.target
