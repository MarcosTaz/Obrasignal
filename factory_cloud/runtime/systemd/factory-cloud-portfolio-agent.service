[Unit]
Description=Factory Cloud Shared Portfolio Agent Runtime
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/factory-cloud
EnvironmentFile=-/etc/factory-cloud/portfolio-agent.env
ExecStart=/opt/factory-cloud/.venv/bin/python -c "from factory_cloud.portfolio_agent_service import make_agent_server; s=make_agent_server('127.0.0.1',8788); s.serve_forever(poll_interval=0.25)"
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
