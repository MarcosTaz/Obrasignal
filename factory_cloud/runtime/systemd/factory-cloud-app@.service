[Unit]
Description=Factory Cloud isolated app worker (%i)
After=network-online.target factory-cloud-control.service
Wants=network-online.target
Requires=factory-cloud-control.service

[Service]
Type=simple
User=factory-cloud-%i
Group=factory-cloud-%i
SupplementaryGroups=factory-cloud
WorkingDirectory=/opt/factory-cloud/current
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-/etc/factory-cloud/apps/%i.env
ExecStart=/usr/bin/python3 -m factory_cloud.app_worker Ω --app-id %i --state /var/lib/factory-cloud/state.sqlite3 --adapter-config /etc/factory-cloud/apps/%i.json
Restart=always
RestartSec=5
UMask=0007
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=factory-cloud.target
