FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    FACTORY_CONTROL_HOST=0.0.0.0 \
    FACTORY_CONTROL_PORT=8787 \
    FACTORY_CLOUD_RUNTIME_DIR=/var/lib/factory-cloud

WORKDIR /app
COPY requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r /app/requirements.txt
COPY . /app
RUN mkdir -p /var/lib/factory-cloud
EXPOSE 8787
CMD ["python", "-m", "factory_cloud.control_tower_service", "--host", "0.0.0.0", "--port", "8787", "--runtime-dir", "/var/lib/factory-cloud"]
