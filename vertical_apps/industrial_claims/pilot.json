{
  "schema_version": 4,
  "vertical": "industrial-claims",
  "mode": "assisted",
  "wedge": "supplier-side recovery after material industrial or commercial events",
  "required_inputs": [
    "commercial_basis_reference_and_document_content",
    "customer_program_event_reference_and_document_content",
    "cost_evidence_reference_and_document_content",
    "claim_currency",
    "gross_cost",
    "mitigation_and_prior_recovery",
    "notice_deadline_or_verified_none"
  ],
  "evidence_policy": {
    "reference_only_is_review_ready": false,
    "document_content_hashed": true,
    "raw_document_content_persisted_by_service": false,
    "individual_document_content_limit_bytes": 1000000
  },
  "economic_lineage": {
    "currency_required_for_review_ready": true,
    "currency_normalized_uppercase": true,
    "recovery_currency_must_match_reviewed_currency": true,
    "currency_conversion_implemented": false
  },
  "identity_authorization": {
    "source": "verified_provider_identity",
    "raw_identity_headers_authoritative": false,
    "roles": {
      "analyze": "analyst",
      "review": "reviewer",
      "action": "operator",
      "resolve": "operator"
    },
    "admin_override": true,
    "four_eyes_review_required": true,
    "admin_may_self_review": false
  },
  "outputs": [
    "evidence_envelope_with_verification_state",
    "entitlement_basis",
    "reproducible_net_potential_calculation_with_currency",
    "notice_deadline_truth_state",
    "missing_evidence",
    "reviewable_finding",
    "actor_audit_lineage",
    "outcome_record"
  ],
  "fail_closed": [
    "cost_without_commercial_basis",
    "missing_event_evidence",
    "reference_only_documentary_evidence",
    "partial_entitlement_basis",
    "unknown_notice_deadline",
    "missing_claim_currency",
    "invalid_claim_currency",
    "recovery_currency_mismatch",
    "negative_economic_input",
    "non_finite_economic_input",
    "mitigation_exceeds_gross_cost",
    "recovery_exceeds_reviewed_net_potential",
    "duplicate_recovery_fingerprint",
    "duplicate_success_fee",
    "cross_tenant_composition",
    "unverified_identity",
    "tenant_identity_mismatch",
    "missing_required_role",
    "self_review",
    "unsupported_review_transition",
    "partial_case_persistence"
  ],
  "operator_console": {
    "status": "REPOSITORY_IMPLEMENTED",
    "external_runtime_exposure": false,
    "content_security_policy_required": true,
    "html_injection_renderer_forbidden": true,
    "cache_case_responses": false,
    "tenant_scoped_role_queue": true
  },
  "pricing": {
    "status": "HYPOTHESIS",
    "currency": "EUR",
    "audit_fee_min": 0,
    "audit_fee_max": 5000,
    "success_fee_percent_min": 10,
    "success_fee_percent_max": 25
  },
  "pilot_exit_criteria": [
    "canonical_source_green",
    "synthetic_ground_truth_green",
    "all_claim_families_structurally_supported",
    "documentary_content_gate_green",
    "currency_lineage_green",
    "tenant_isolation_green",
    "role_authorization_green",
    "four_eyes_green",
    "operation_audit_green",
    "atomic_persistence_green",
    "backup_restart_green",
    "tenant_scoped_role_queue_green",
    "operator_console_green",
    "browser_security_green",
    "no_known_p0_p1",
    "runtime_provisioned",
    "provider_role_mapping_verified",
    "pricing_validated_or_revised"
  ],
  "commercial_success": {
    "status": "UNPROVEN",
    "requires": [
      "real_incremental_recovery_gt_zero",
      "real_customer_revenue_gt_zero"
    ]
  },
  "production_authority": false
}
