# Required for private founder access. Use unique high-entropy random secrets.
# Minimum accepted lengths: admin token 16 chars; session secret 32 chars.
FCC_ADMIN_TOKEN=
FCC_SESSION_SECRET=

# Required only when Factories push ACTIVE/NEXT/WAIT into the machine feed.
# Keep separate from the founder token and send server-to-server as Bearer auth.
# Minimum accepted length: 16 chars.
FCC_FACTORY_INGEST_TOKEN=

# Required only when canonical billing/CRM sources push revenue, pipeline or customer metrics.
# Keep separate from founder/Factory tokens and send server-to-server as Bearer auth.
# Minimum accepted length: 16 chars.
FCC_METRIC_INGEST_TOKEN=

# Optional read-only live GitHub adapter token. Never expose this client-side.
# Tokens shorter than 16 chars or containing unsafe surrounding/control characters are treated as not configured and are not sent.
FCC_GITHUB_TOKEN=

# Production HTTPS should keep this enabled.
FCC_SECURE_COOKIE=1

# Optional SQLite path override.
FCC_DB=
