# Supabase public client configuration.
# Never commit real values here; configure them in local .env or EAS environment variables.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# API base URL used by the mobile/web client.
EXPO_PUBLIC_API_URL=

# RevenueCat public SDK keys (safe for client builds; never use secret API keys here).
# Native builds use their store-specific keys. Web may use the RevenueCat Web SDK key.
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_WEB_KEY=

# Optional production RevenueCat Web Purchase Link. This is the preferred
# failover for the signed-in Web experience and can use a Stripe Billing web
# config. Use only a production https://pay.rev.cat/<token> URL; sandbox links
# are rejected by the client.
EXPO_PUBLIC_REVENUECAT_PURCHASE_LINK=
