# Supabase public client configuration.
# Never commit real values here; configure them in local .env or EAS environment variables.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# API base URL used by the mobile client.
EXPO_PUBLIC_API_URL=

# RevenueCat public SDK keys (safe for client builds; do not use secret API keys).
# Configure the Android/iOS public app keys in EAS environment variables for release builds.
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
