      "next_action": "REVIEW_HISTORY_OR_OWNER_ALLOWED_WORKFLOW_ONLY",
      "forbidden_claims": ["pursue_now", "open", "deadline_available_when_closed", "automatic_workflow_transition_permission"],
      "owner_dependencies": ["Lifecycle/Actionability", "State Machine/Workflow", "Web/Mobile presentation"]
    },
    {
      "id": "PROFILE_INCOMPLETE",
      "profile_state": "INCOMPLETE_OR_INVALID",
      "source_state": "IRRELEVANT_TO_THIS_OUTCOME",
      "opportunity_state": "MUST_NOT_BE_PRESENTED_AS_PERSONALIZED_VALUE",
      "decision_state": "NOT_READY_FOR_CUSTOMER_CLAIM",
      "actionability_state": "N/A",
      "expected_outcome": "EDIT_PROFILE_REQUIRED",
      "customer_truth": "The product tells the customer what profile information is required and does not present apparently personalized current relevance as if a usable profile existed.",
