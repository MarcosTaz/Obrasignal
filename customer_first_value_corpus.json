      "profile_state": "VALID_CURRENT",
      "source_state": "PARTIAL_OR_DEGRADED",
      "opportunity_state": "ZERO_OR_SOME_RESULTS",
      "decision_state": "BOUNDED_TO_AVAILABLE_DATA",
      "actionability_state": "PER_OPPORTUNITY_CURRENTNESS_REQUIRED",
      "expected_outcome": "CURRENTNESS_UNCONFIRMED",
      "customer_truth": "Available results may be useful, but partial coverage cannot be presented as complete market truth and an empty result cannot become zero market.",
      "next_action": "INSPECT_AVAILABLE_RESULTS_WITH_COVERAGE_DISCLOSURE_OR_RETRY",
      "forbidden_claims": ["coverage_complete", "zero_market", "all_relevant_opportunities_seen"],
      "owner_dependencies": ["Source Health", "Data Integrity"]
