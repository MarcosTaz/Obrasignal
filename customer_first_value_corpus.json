    {
      "id": "SYSTEM_FAILURE",
      "profile_state": "ANY",
      "source_state": "UNKNOWN_DUE_TO_SYSTEM_FAILURE",
      "opportunity_state": "UNKNOWN_OR_STALE_CACHE",
      "decision_state": "UNKNOWN_OR_PREVIOUSLY_CACHED",
      "actionability_state": "UNKNOWN_UNLESS_CURRENTLY_PROVEN",
      "expected_outcome": "RETRY_SYSTEM_FAILURE",
      "customer_truth": "A system/network/API failure is disclosed as failure or possible staleness; cached information may aid continuity but is not relabeled current authority.",
      "next_action": "RETRY",
