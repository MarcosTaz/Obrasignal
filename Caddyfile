:{$PORT:8080} {
    root * /srv
    encode zstd gzip
    file_server

    header {
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "no-referrer"
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
        Content-Security-Policy "default-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; object-src 'none'; connect-src 'none'; script-src 'none'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
        Cross-Origin-Opener-Policy "same-origin"
        Cross-Origin-Resource-Policy "same-origin"
    }

    @release path /release.json
    header @release Cache-Control "no-store"
}
